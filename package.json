{
  "name": "mw-playground",
  "version": "0.1.0",
  "private": true,
  "description": "本机运行的浏览器 3D 小游戏：导入模匠导出的角色，替换主角或加入为同伴、守卫。",
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "inspect-asset": "tsx scripts/inspect-asset.ts",
    "lock-summary": "tsx scripts/lock-summary.ts"
  },
  "dependencies": {
    "three": "0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "@types/three": "0.187.0",
    "eslint": "10.14.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
